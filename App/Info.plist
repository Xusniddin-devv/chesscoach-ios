<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys the generated Info.plist cannot carry; everything else is INFOPLIST_KEY_* in project.yml. -->
	<key>RevenueCatAPIKey</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>
	<!-- Auto-sync of the linked chess.com / Lichess account (GameAutoSync.backgroundTaskID). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>uz.xq.chessc.sync</string>
	</array>
</dict>
</plist>
